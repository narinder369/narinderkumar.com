# ==============================================================================
# NarinderKumar.com — Environment Variable Configuration Template
# ==============================================================================

# 1. APPLICATION & DOMAIN
NEXT_PUBLIC_SITE_URL=https://narinderkumar.com
NEXT_PUBLIC_SITE_NAME="Narinder Kumar"

# 2. SUPABASE (Database, Auth, and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-ONLY SUPABASE SERVICE KEY (NEVER EXPOSE IN CLIENT CODE)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. RAZORPAY (India Payments — UPI, NetBanking, Cards)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 4. STRIPE (International Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# 5. TRANSACTIONAL EMAIL (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Narinder Kumar <hello@narinderkumar.com>"

# 6. ANALYTICS & MONITORING
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-43CE14BHF1
